{
  "expo": {
    "name": "Balla",
    "slug": "balla",
    "version": "0.92.0",
    "scheme": [
      "balla",
      "click.croft.balla"
    ],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0866FF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "click.croft.balla"
    },
    "android": {
      "package": "click.croft.balla",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0866FF"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png",
      "name": "Balla",
      "shortName": "Balla",
      "lang": "en-GB",
      "themeColor": "#0866FF",
      "backgroundColor": "#F0F2F5",
      "description": "A chronological, Facebook-inspired Bluesky client."
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Balla needs access to your photos so you can add photos to posts or choose a profile picture or banner.",
          "cameraPermission": "Balla needs access to your camera so you can take a photo for a post."
        }
      ],
      "expo-video",
      [
        "expo-alternate-app-icons",
        [
          {
            "name": "Dark",
            "ios": "./assets/app-icons/ios_icon_legacy_dark.png",
            "android": {
              "foregroundImage": "./assets/app-icons/android_icon_legacy_dark.png",
              "backgroundColor": "#0E1420"
            }
          }
        ]
      ]
    ],
    "experiments": {
      "baseUrl": "/app"
    }
  }
}
