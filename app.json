{
  "expo": {
    "name": "Balla",
    "slug": "balla",
    "version": "0.1.0",
    "scheme": ["balla", "click.croft.balla"],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1877F2"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "click.croft.balla"
    },
    "android": {
      "package": "click.croft.balla",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1877F2"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png",
      "name": "Balla",
      "shortName": "Balla",
      "lang": "en-GB",
      "themeColor": "#1877F2",
      "backgroundColor": "#F0F2F5",
      "description": "A chronological, Facebook-shaped Bluesky client."
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Balla needs access to your photos so you can add photos to posts or choose a profile picture or banner.",
          "cameraPermission": "Balla needs access to your camera so you can take a photo for a post."
        }
      ]
    ],
    "experiments": {
      "baseUrl": "/app"
    }
  }
}
